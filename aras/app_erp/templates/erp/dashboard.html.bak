{% extends 'admin/adm_base.html' %}

{% block page_content %}
<div class="row mt-4">
  <div class="col-12 mb-3">
    <h4>ERP</h4>
    <p class="text-muted">Pilih modul di bawah untuk memulai.</p>
  </div>

  {# Core #}
  <div class="col-12 mb-2">
    <h6 class="text-uppercase text-muted" style="font-size:11px;letter-spacing:1px;">Core</h6>
  </div>
  {% set core_modules = [
    ("Company",     "fa-building-o", "/admin/erp/company/"),
    ("Currency",    "fa-dollar",     "/admin/erp/currency/"),
    ("Tax",         "fa-percent",    "/admin/erp/tax/"),
    ("Fiscal Year", "fa-calendar",   "/admin/erp/fiscal-year/"),
    ("Settings",    "fa-sliders",    "/admin/erp/setting/"),
  ] %}
  {% for title, icon, url in core_modules %}
  <div class="col-6 col-md-3 col-lg-2 mb-3">
    <a href="{{ url }}" class="card text-center text-decoration-none h-100" style="border:1px solid #e8edf0;">
      <div class="card-body py-3">
        <i class="fa {{ icon }} fa-2x text-secondary mb-2"></i>
        <div style="font-size:13px;">{{ title }}</div>
      </div>
    </a>
  </div>
  {% endfor %}

  {# Accounting #}
  <div class="col-12 mb-2 mt-3">
    <h6 class="text-uppercase text-muted" style="font-size:11px;letter-spacing:1px;">Accounting</h6>
  </div>
  {% set acc_modules = [
    ("Chart of Accounts",  "fa-sitemap",         "/admin/erp/acc/account/"),
    ("Journals",           "fa-book",            "/admin/erp/acc/journal/"),
    ("Journal Entries",    "fa-pencil-square-o", "/admin/erp/acc/entry/"),
    ("Sales Invoices",     "fa-file-text-o",     "/admin/erp/acc/sales-invoice/"),
    ("Purchase Invoices",  "fa-file-o",          "/admin/erp/acc/purchase-invoice/"),
    ("Bank Statements",    "fa-bank",            "/admin/erp/acc/bank/"),
  ] %}
  {% for title, icon, url in acc_modules %}
  <div class="col-6 col-md-3 col-lg-2 mb-3">
    <a href="{{ url }}" class="card text-center text-decoration-none h-100" style="border:1px solid #e8edf0;">
      <div class="card-body py-3">
        <i class="fa {{ icon }} fa-2x text-secondary mb-2"></i>
        <div style="font-size:13px;">{{ title }}</div>
      </div>
    </a>
  </div>
  {% endfor %}

  {# CRM #}
  <div class="col-12 mb-2 mt-3">
    <h6 class="text-uppercase text-muted" style="font-size:11px;letter-spacing:1px;">CRM</h6>
  </div>
  {% set crm_modules = [
    ("Customers", "fa-user-circle",  "/admin/erp/crm/customer/"),
    ("Contacts",  "fa-address-book", "/admin/erp/crm/contact/"),
    ("Leads",     "fa-filter",       "/admin/erp/crm/lead/"),
    ("Pipelines", "fa-random",       "/admin/erp/crm/pipeline/"),
  ] %}
  {% for title, icon, url in crm_modules %}
  <div class="col-6 col-md-3 col-lg-2 mb-3">
    <a href="{{ url }}" class="card text-center text-decoration-none h-100" style="border:1px solid #e8edf0;">
      <div class="card-body py-3">
        <i class="fa {{ icon }} fa-2x text-secondary mb-2"></i>
        <div style="font-size:13px;">{{ title }}</div>
      </div>
    </a>
  </div>
  {% endfor %}

  {# Reports #}
  <div class="col-12 mb-2 mt-3">
    <h6 class="text-uppercase text-muted" style="font-size:11px;letter-spacing:1px;">Reports</h6>
  </div>
  {% set report_modules = [
    ("Reports",         "fa-bar-chart",   "/admin/erp/reports/"),
    ("POS Shift Report","fa-clock-o",     "/admin/erp/reports/pos-shift/"),
  ] %}
  {% for title, icon, url in report_modules %}
  <div class="col-6 col-md-3 col-lg-2 mb-3">
    <a href="{{ url }}" class="card text-center text-decoration-none h-100" style="border:1px solid #e8edf0;">
      <div class="card-body py-3">
        <i class="fa {{ icon }} fa-2x text-secondary mb-2"></i>
        <div style="font-size:13px;">{{ title }}</div>
      </div>
    </a>
  </div>
  {% endfor %}

  {# POS #}
  <div class="col-12 mb-2 mt-3">
    <h6 class="text-uppercase text-muted" style="font-size:11px;letter-spacing:1px;">arasPos</h6>
  </div>
  {% set pos_modules = [
    ("Buka POS",  "fa-play-circle", "/admin/erp/pos"),
    ("Terminals", "fa-desktop",     "/admin/erp/pos/terminal/"),
    ("Sessions",  "fa-clock-o",     "/admin/erp/pos/session/"),
    ("Orders",    "fa-list",        "/admin/erp/pos/order/"),
  ] %}
  {% for title, icon, url in pos_modules %}
  <div class="col-6 col-md-3 col-lg-2 mb-3">
    <a href="{{ url }}" class="card text-center text-decoration-none h-100" style="border:1px solid #e8edf0;">
      <div class="card-body py-3">
        <i class="fa {{ icon }} fa-2x text-secondary mb-2"></i>
        <div style="font-size:13px;">{{ title }}</div>
      </div>
    </a>
  </div>
  {% endfor %}

  {# Stock #}
  <div class="col-12 mb-2 mt-3">
    <h6 class="text-uppercase text-muted" style="font-size:11px;letter-spacing:1px;">Stock</h6>
  </div>
  {% set stock_modules = [
    ("Products",       "fa-cube",          "/admin/erp/stock/product/"),
    ("Price Lists",    "fa-tag",           "/admin/erp/stock/pricelist/"),
    ("Warehouses",     "fa-building-o",    "/admin/erp/stock/warehouse/"),
    ("Locations",      "fa-map-marker",    "/admin/erp/stock/location/"),
    ("Stock Movements","fa-exchange",      "/admin/erp/stock/movement/"),
    ("Valuation",      "fa-bar-chart",     "/admin/erp/stock/valuation/"),
    ("Units of Measure","fa-balance-scale","/admin/erp/stock/uom/"),
  ] %}
  {% for title, icon, url in stock_modules %}
  <div class="col-6 col-md-3 col-lg-2 mb-3">
    <a href="{{ url }}" class="card text-center text-decoration-none h-100" style="border:1px solid #e8edf0;">
      <div class="card-body py-3">
        <i class="fa {{ icon }} fa-2x text-secondary mb-2"></i>
        <div style="font-size:13px;">{{ title }}</div>
      </div>
    </a>
  </div>
  {% endfor %}
</div>
{% endblock %}
